# Copy this file to .env and adjust for your setup.
# Comma-separated list of frontend origins allowed to connect (no trailing slashes).
# Origins must match exactly: 127.0.0.1 and localhost count as different origins.
CLIENT_URL=http://127.0.0.1:5500,http://localhost:5500

# Optional. Defaults to 5000 locally. Render sets this itself, so don't set it there.
# PORT=5000
